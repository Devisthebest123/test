{
  "name": "whisper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private notes and private SOL on Solana. Dead drops with no program, no server and no recipient on chain.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "deploy": "npm run build && wrangler deploy",
    "vectors": "node --experimental-strip-types scripts/vectors.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.2",
    "@noble/hashes": "^1.8.0",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-node-polyfills": "^0.24.0",
    "wrangler": "^4.156.0"
  },
  "license": "MIT"
}
